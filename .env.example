# LeadPilot AI environment configuration.
# Copy to .env and fill in real values. NEVER commit .env.
# Validated at runtime by src/lib/configuration/env.ts (errors list variable names only).
# [required] = app refuses to start without it; [optional] = has a safe default or disables a feature.

# --- Local Postgres (docker-compose.yml) ------------------------------------
# [required for docker compose] Read by the postgres container on first start.
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=leadpilot
# [optional] Host port, bound to 127.0.0.1 only. 55432 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=55432

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# [required] Postgres connection string. Use a least-privilege app role, not the superuser.
DATABASE_URL=postgres://leadpilot:replace-with-a-random-password@127.0.0.1:55432/leadpilot
# [required for npm run test:integration] Separate database; tests TRUNCATE every table in it.
# Created automatically by database/docker/init on the first `docker compose up`.
TEST_DATABASE_URL=postgres://leadpilot:replace-with-a-random-password@127.0.0.1:55432/leadpilot_test
# [optional] Connection pool size (1-100).
DATABASE_POOL_MAX=10
# [required] >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# [optional] Public URL of the app. Also the only Origin accepted for state-changing API calls (CSRF).
APP_BASE_URL=http://localhost:3000
# [optional] Session lifetime in hours (1-720).
SESSION_TTL_HOURS=72
# Optional single admin login (sign in with this username instead of an e-mail; no seed needed). Set both or neither;
# the password needs 8+ characters. The app keeps one ADMIN user row for it; change the password here, not in the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# [optional] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Seed (database/seeds/seed.ts only; not read by the running app) --------
# [required for npm run db:seed] First admin account. Password >= 12 characters. Never reset by re-running the seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-password

# --- Run execution (runs execute inside the web app) ------------------------
# [optional] Seconds a run holds its lease before it may be resumed (30-3600).
RUN_LEASE_SECONDS=300
# [optional] Jobs per AI batch (1-50), parallel AI calls (1-10), messages per notify batch (1-50).
AI_BATCH_SIZE=5
AI_CONCURRENCY=2
NOTIFY_BATCH_SIZE=5

# --- AI scoring (OpenAI) ----------------------------------------------------
# Without a key, AI scoring reports "not configured" and jobs that reach scoring end as AI errors.
# [required for scoring] From https://platform.openai.com/api-keys (use a project-scoped key).
OPENAI_API_KEY=
# [required for scoring] Model identifier, recorded on every qualification.
OPENAI_MODEL=
# [optional] Request timeout in ms (1000-120000).
OPENAI_TIMEOUT_MS=30000

# --- E-mail alerts -----------------------------------------------------------
# Lead alerts, run summaries and failure alerts are sent by e-mail. Without settings, e-mail reports
# "not configured" and no alert is sent.
# [optional] smtp (default) | brevo (HTTPS API, for hosts that block SMTP ports, e.g. Render free)
EMAIL_PROVIDER=smtp
# [required when smtp] Any SMTP mailbox, e.g. smtp.gmail.com with a Google "app password", or Zoho Mail.
SMTP_HOST=
# [optional] 587 = STARTTLS (SMTP_SECURE=false); 465 = TLS from the start (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# [required when smtp or brevo] Sender shown to recipients, e.g. LeadPilot <alerts@example.com>
# (with brevo it must be a sender verified in Brevo).
EMAIL_FROM=
SMTP_TIMEOUT_MS=15000
# [required when EMAIL_PROVIDER=brevo] Brevo API key (SMTP & API -> API keys). For hosts that block SMTP
# ports, e.g. Render's free plan. Secret.
BREVO_API_KEY=
BREVO_TIMEOUT_MS=15000

# [optional] How many proxies in front of the app append to X-Forwarded-For (default 1, right for Render).
# The client address used for login rate limits is that many entries from the end.
# TRUSTED_PROXY_HOPS=1

# [optional] "true" applies database migrations when the web server starts (src/instrumentation.ts).
# Set on Render, which has no separate migration step. Locally, run `npm run db:migrate` instead.
# MIGRATE_ON_START=true

# --- Job source ---------------------------------------------------------------
# Runs only process jobs the Upwork sync delivered through the import API (see docs/upwork-sync.md).
# The automated tests use fakes instead (tests/fakes; the browser tests set E2E_FAKE_PROVIDERS=1, which
# the app refuses unless APP_BASE_URL is a localhost address).

# --- Upwork sync agent (Claude + Upwork MCP; see docs/upwork-sync.md) --------
# [optional] Scheduled (unattended) syncs get no due profiles until this is true. Read Upwork's
# API & MCP Terms of Use first. Manual /upwork-sync runs always work.
UPWORK_SYNC_SCHEDULED_ALLOWED=false
# [required for scripts/leadpilot-import.mjs] Where the agent sends jobs, and the import token
# created in Settings > Import tokens. Read by the script only, not by the app.
LEADPILOT_URL=http://localhost:3000
LEADPILOT_IMPORT_TOKEN=
