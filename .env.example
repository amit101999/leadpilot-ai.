# LeadPilot AI environment configuration.
# Copy to .env and fill in real values. NEVER commit .env.
# Validated at runtime by src/lib/configuration/env.ts (errors list variable names only).
# [required] = app refuses to start without it; [optional] = has a safe default or disables a feature.

# --- Local Postgres (docker-compose.yml) ------------------------------------
# [required for docker compose] Read by the postgres container on first start.
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=leadpilot
# [optional] Host port, bound to 127.0.0.1 only. 55432 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=55432

# --- Core -------------------------------------------------------------------
NODE_ENV=development
# [required] Postgres connection string. Use a least-privilege app role, not the superuser.
DATABASE_URL=postgres://leadpilot:replace-with-a-random-password@127.0.0.1:55432/leadpilot
# [required for npm run test:integration] Separate database; tests TRUNCATE every table in it.
# Created automatically by database/docker/init on the first `docker compose up`.
TEST_DATABASE_URL=postgres://leadpilot:replace-with-a-random-password@127.0.0.1:55432/leadpilot_test
# [optional] Connection pool size (1-100).
DATABASE_POOL_MAX=10
# [required] >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# [optional] Public URL of the app. Also the only Origin accepted for state-changing API calls (CSRF).
APP_BASE_URL=http://localhost:3000
# [optional] Session lifetime in hours (1-720).
SESSION_TTL_HOURS=72
# [optional] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Seed (database/seeds/seed.ts only; not read by the running app) --------
# [required for npm run db:seed] First admin account. Password >= 12 characters. Never reset by re-running the seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-password

# --- Run execution ----------------------------------------------------------
# [optional] inprocess (default, runs inside the web app) | n8n (orchestrated by the n8n service)
RUN_EXECUTOR=inprocess
# [required when RUN_EXECUTOR=n8n] Base URL of n8n as reachable from the web app.
N8N_BASE_URL=
# [optional] Path of the n8n run webhook.
N8N_WEBHOOK_PATH=/webhook/leadpilot-run
# [required when RUN_EXECUTOR=n8n] Shared secret the app uses to sign webhook calls to n8n.
N8N_WEBHOOK_SECRET=
# [required when RUN_EXECUTOR=n8n] Secret n8n uses to sign calls to /api/internal/**. Different from N8N_WEBHOOK_SECRET.
INTERNAL_API_SECRET=
# [optional] Seconds an executor holds a run lease before another may resume it (30-3600).
RUN_LEASE_SECONDS=300
# [optional] Jobs per AI batch (1-50), parallel AI calls (1-10), messages per notify batch (1-50).
AI_BATCH_SIZE=5
AI_CONCURRENCY=2
NOTIFY_BATCH_SIZE=5

# --- AI ---------------------------------------------------------------------
# [optional] mock (default, no external calls) | openai
AI_PROVIDER=mock
# [required when AI_PROVIDER=openai] From https://platform.openai.com/api-keys (use a project-scoped key).
OPENAI_API_KEY=
# [required when AI_PROVIDER=openai] Model identifier, recorded on every qualification.
OPENAI_MODEL=
# [optional] Request timeout in ms (1000-120000).
OPENAI_TIMEOUT_MS=30000

# --- WhatsApp Business Cloud API -------------------------------------------
# [optional] mock (default, records messages locally) | cloud
WHATSAPP_PROVIDER=mock
# [required when cloud] System-user access token from Meta Business Manager (WhatsApp > API setup).
WHATSAPP_ACCESS_TOKEN=
# [required when cloud] Phone number ID (not the phone number) from WhatsApp > API setup.
WHATSAPP_PHONE_NUMBER_ID=
# [optional, not read by the code yet] WhatsApp Business Account ID, kept for reference.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# [optional] E.164 number (e.g. +14155550123). Used only by the seed to create a recipient; opt-in must still be confirmed in Settings.
WHATSAPP_DEFAULT_RECIPIENT=
# [required for GET /api/webhooks/whatsapp] Any random string; enter the same value in the Meta webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# [required for POST /api/webhooks/whatsapp] Meta app secret, used to verify X-Hub-Signature-256. Without it every webhook is refused.
WHATSAPP_APP_SECRET=
# [required when cloud] Approved message template names (Meta > WhatsApp Manager > Message templates).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_SUMMARY_TEMPLATE_NAME=
# [optional] Template used by the connection test. Meta provisions hello_world on new accounts.
WHATSAPP_TEST_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# [optional] Graph API version, format vNN.N.
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TIMEOUT_MS=15000

# --- Job source -------------------------------------------------------------
# [optional] mock (default) | upwork. Live Upwork discovery stays BLOCKED until access is approved and verified.
JOB_SOURCE_PROVIDER=mock
# [reserved] For a future authorized job-source adapter. Not used by the current code.
JOB_SOURCE_API_BASE_URL=
JOB_SOURCE_API_KEY=
# [required when upwork] From an approved Upwork API key request:
# https://support.upwork.com/hc/en-us/articles/115015857647-How-to-request-an-API-key-from-Upwork
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# [optional] Set to true ONLY after Upwork has granted job-search access for this key.
UPWORK_JOB_SEARCH_SCOPE_CONFIRMED=false
# [optional] Mock source scenario: default | unauthorized (simulates a blocked source).
MOCK_SOURCE_SCENARIO=default
